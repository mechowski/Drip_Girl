# Скопируйте в .env рядом с compose.yaml и задайте свои значения.
# Без .env Compose использует локальные тестовые пароли из compose.yaml —
# они подходят только для запуска на 127.0.0.1.
POSTGRES_PASSWORD=change-me-postgres
DRIP_GIRL_OWNER_PASSWORD=change-me-owner
DRIP_GIRL_APP_PASSWORD=change-me-app
POSTGRES_DB=drip_girl
DRIP_OPERATOR_PASSWORD=change-me-operator
DRIP_ADMIN_PASSWORD=change-me-admin

# Реальные интеграции в тестовом запуске не используются.
# MOYSKLAD_TOKEN=
# MOYSKLAD_CONFIG=
